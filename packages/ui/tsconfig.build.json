{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["vite/client"],
    "allowArbitraryExtensions": true
  },
  "include": ["src/index.ts", "src/components/**/*.vue", "src/components/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.stories.ts"]
}
