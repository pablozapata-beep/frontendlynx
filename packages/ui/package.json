{
  "name": "@frontendlinx/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/frontendlinx-ui.js",
  "module": "./dist/frontendlinx-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/frontendlinx-ui.js"
    },
    "./style.css": "./dist/frontendlinx-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
